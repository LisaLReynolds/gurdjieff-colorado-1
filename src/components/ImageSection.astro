---
const {
  title,
  text,
  image,
  alt,
  reverse = false,
  bg = "default" // new prop
} = Astro.props;
---

<section class={`feature feature-${bg} ${reverse ? 'feature-reverse' : ''}`}>
  <div class="container feature-grid">
    
    <div class="feature-text">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>

    <div class="feature-image">
      <img src={image} alt={alt} loading="lazy" />
    </div>

  </div>
</section>
